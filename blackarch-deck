"""


class CyberdeckHTTPHandler(http.server.BaseHTTPRequestHandler):
    engine: TelemetryEngine = TelemetryEngine()

    def log_message(self, format: str, *args: Any) -> None:
        return  # Keep console clean

    def _send_json(self, data: Any, status: int = 200) -> None:
        raw = json.dumps(data).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(raw)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(raw)

    def do_GET(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path in ("/", "/index.html"):
            raw = WEB_UI_HTML.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(raw)))
            self.end_headers()
            self.wfile.write(raw)
        elif parsed.path == "/api/telemetry":
            cfg = load_config()
            self._send_json(self.engine.collect_all(cfg))
        elif parsed.path == "/api/config":
            self._send_json(load_config())
        elif parsed.path == "/api/commands":
            self._send_json(load_commands())
        else:
            self._send_json({"error": "Not found"}, status=404)

    def do_POST(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        length = int(self.headers.get("Content-Length", "0"))
        body = self.rfile.read(length).decode("utf-8") if length > 0 else "{}"
        try:
            payload = json.loads(body)
        except Exception:
            payload = {}

        if parsed.path == "/api/config":
            cfg = load_config()
            refresh_wx = bool(payload.pop("refresh_weather", False))
            cfg.update(payload)
            save_config(cfg)
            if refresh_wx:
                self.engine.get_weather(cfg, force=True)
            self._send_json(cfg)
        elif parsed.path == "/api/commands":
            if payload.get("action") == "save_all" and isinstance(payload.get("commands"), list):
                save_commands(payload["commands"])
            self._send_json(load_commands())
        elif parsed.path == "/api/execute":
            cmd_str = str(payload.get("cmd", "")).strip()
            if not cmd_str:
                self._send_json({"output": "No command specified.", "exit_code": 1})
                return
            try:
                proc = subprocess.Popen(
                    cmd_str,
                    shell=True,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True,
                )
                out, _ = proc.communicate(timeout=20)
                self._send_json({"output": out, "exit_code": proc.returncode})
            except subprocess.TimeoutExpired:
                proc.kill()
                self._send_json(
                    {
                        "output": "[Command timed out after 20s in web console. Run interactive tools in a terminal window.]",
                        "exit_code": 124,
                    }
                )
            except Exception as exc:
                self._send_json({"output": f"Execution error: {exc}", "exit_code": 1})
        else:
            self._send_json({"error": "Not found"}, status=404)


def run_web_server(host: str, port: int, open_gui: bool = False) -> None:
    ensure_config_files()
    server = http.server.ThreadingHTTPServer((host, port), CyberdeckHTTPHandler)
    url = f"http://127.0.0.1:{port}"
    print(f"\033[1;31m[BLACKARCH CYBERDECK]\033[0m Graphical/Web Command Center listening on \033[1;36mhttp://{host}:{port}\033[0m")
    if open_gui and (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        for browser in ("chromium", "google-chrome-stable", "brave", "firefox", "xdg-open"):
            if shutil.which(browser):
                try:
                    if browser in ("chromium", "google-chrome-stable", "brave"):
                        subprocess.Popen([browser, f"--app={url}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    else:
                        subprocess.Popen([browser, url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    break
                except Exception:
                    pass
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nShutting down BlackArch Cyberdeck Web UI.")


