<!-- Modal for Adding / Editing Custom Command -->
<div class="modal-backdrop" id="cmd-modal">
  <div class="modal">
    <div class="panel-header">
      <div class="panel-title" id="modal-title">+ Add Custom Command</div>
      <button class="btn" onclick="closeModal()">✕</button>
    </div>
    <input type="hidden" id="m-id" value="" />
    <div class="form-group">
      <label>Command Title</label>
      <input type="text" id="m-name" placeholder="e.g. Nmap Vulners Scan" />
    </div>
    <div class="form-group">
      <label>Category</label>
      <select id="m-cat">
        <option value="Custom">Custom</option>
        <option value="Recon & OSINT">Recon & OSINT</option>
        <option value="Web & API">Web & API</option>
        <option value="Wi-Fi & Network">Wi-Fi & Network</option>
        <option value="Exploit & Passwords">Exploit & Passwords</option>
        <option value="Forensics & RE">Forensics & RE</option>
        <option value="OPSEC & VPN">OPSEC & VPN</option>
        <option value="Dual-Boot & System">Dual-Boot & System</option>
      </select>
    </div>
    <div class="form-group">
      <label>Command Template (Supports {target}, {lhost}, {lport}, {interface}, {wordlist})</label>
      <input type="text" id="m-cmd" placeholder="nmap -sV --script vulners {target}" />
    </div>
    <div class="form-group">
      <label>Binary / Pacman Package Name</label>
      <input type="text" id="m-pkg" placeholder="nmap" />
    </div>
    <div class="form-group">
      <label>Description & Usage Notes</label>
      <textarea id="m-desc" rows="2" placeholder="What does this command do?"></textarea>
    </div>
    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:14px;">
      <button class="btn" onclick="closeModal()">Cancel</button>
      <button class="btn btn-primary" onclick="submitCustomCommand()">Save Command</button>
    </div>
  </div>
</div>

<script>
const CATEGORIES = [
  "★ Favorites",
  "All Commands",
  "Recon & OSINT",
  "Web & API",
  "Wi-Fi & Network",
  "Exploit & Passwords",
  "Forensics & RE",
  "OPSEC & VPN",
  "Dual-Boot & System",
  "Custom"
];

let activeCategory = "All Commands";
let installedOnly = false;
let allCommands = [];
let currentConfig = {};

function escapeHtml(s) {
  return String(s || "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

function interpolateCmd(template) {
  const t = document.getElementById("ctx-target").value || "127.0.0.1";
  const lh = document.getElementById("ctx-lhost").value || "127.0.0.1";
  const lp = document.getElementById("ctx-lport").value || "4444";
  const iface = document.getElementById("ctx-iface").value || "eth0";
  const wl = document.getElementById("ctx-wordlist").value || "/usr/share/wordlists/rockyou.txt";
  return String(template || "")
    .replace(/\{target\}/g, t)
    .replace(/\{lhost\}/g, lh)
    .replace(/\{lport\}/g, lp)
    .replace(/\{interface\}/g, iface)
    .replace(/\{wordlist\}/g, wl);
}

function renderCategoryTabs() {
  const wrap = document.getElementById("cat-tabs");
  wrap.innerHTML = CATEGORIES.map(cat => {
    const cls = cat === activeCategory ? "cat-tab active" : "cat-tab";
    return `<button class="${cls}" onclick="selectCategory('${escapeHtml(cat)}')">${escapeHtml(cat)}</button>`;
  }).join("");
}

function selectCategory(cat) {
  activeCategory = cat;
  renderCategoryTabs();
  renderCommands();
}

function toggleInstalledOnly() {
  installedOnly = !installedOnly;
  document.getElementById("btn-inst-filter").textContent = installedOnly ? "Filter: Installed Only ✓" : "Filter: All Tools";
  renderCommands();
}

function renderCommands() {
  const q = (document.getElementById("cmd-search").value || "").toLowerCase().trim();
  const filtered = allCommands.filter(c => {
    if (activeCategory === "★ Favorites" && !c.favorite) return false;
    if (activeCategory !== "★ Favorites" && activeCategory !== "All Commands" && c.category !== activeCategory) return false;
    if (installedOnly && !c.installed) return false;
    if (q) {
      const hay = `${c.name} ${c.cmd} ${c.description} ${(c.tags || []).join(" ")} ${c.category}`.toLowerCase();
      if (!hay.includes(q)) return false;
    }
    return true;
  });

  document.getElementById("cmd-count").textContent = filtered.length;
  const grid = document.getElementById("cmd-grid");
  grid.innerHTML = filtered.map(c => {
    const rendered = interpolateCmd(c.cmd);
    const badge = c.installed
      ? `<span class="badge ok">✓ INSTALLED</span>`
      : `<span class="badge pkg">📦 pacman -S ${escapeHtml(c.package || c.binary)}</span>`;
    const star = c.favorite ? "★" : "☆";
    return `
      <div class="cmd-card">
        <div>
          <div class="cmd-card-top">
            <div class="cmd-name">${escapeHtml(c.name)}</div>
            ${badge}
          </div>
          <div style="font-size:10.5px;color:var(--crimson);margin:3px 0;">${escapeHtml(c.category)}</div>
          <div class="cmd-desc">${escapeHtml(c.description)}</div>
        </div>
        <div>
          <div class="cmd-code">$ ${escapeHtml(rendered)}</div>
          <div class="cmd-actions">
            <button class="btn" title="Toggle Favorite" onclick="toggleFavorite('${escapeHtml(c.id)}')">${star}</button>
            <button class="btn" onclick="copyCmd('${escapeHtml(c.id)}')">📋 Copy</button>
            <button class="btn" onclick="editCmd('${escapeHtml(c.id)}')">✎ Edit</button>
            ${c.category === 'Custom' ? `<button class="btn" onclick="deleteCmd('${escapeHtml(c.id)}')">🗑</button>` : ''}
            <button class="btn btn-primary" onclick="executeCardCmd('${escapeHtml(c.id)}')">▶ Execute</button>
          </div>
        </div>
      </div>
    `;
  }).join("");
}

async function fetchInitialData() {
  renderCategoryTabs();
  const [cfgRes, cmdRes] = await Promise.all([
    fetch("/api/config"),
    fetch("/api/commands")
  ]);
  currentConfig = await cfgRes.json();
  allCommands = await cmdRes.json();

  document.getElementById("ctx-target").value = currentConfig.target || "10.10.11.24";
  document.getElementById("ctx-lhost").value = currentConfig.lhost || "127.0.0.1";
  document.getElementById("ctx-lport").value = currentConfig.lport || "4444";
  document.getElementById("ctx-iface").value = currentConfig.interface || "eth0";
  document.getElementById("ctx-wordlist").value = currentConfig.wordlist || "/usr/share/wordlists/rockyou.txt";

  renderCommands();
  refreshTelemetry();
}

async function refreshTelemetry() {
  try {
    const res = await fetch("/api/telemetry");
    const d = await res.json();

    // Header & Clock
    document.getElementById("clock-time").textContent = d.system.time;
    document.getElementById("clock-date").textContent = `${d.system.date} (${d.system.timezone})`;
    document.getElementById("hdr-os").textContent = `${d.system.os} • Kernel ${d.system.kernel} • Load ${d.system.load_avg}`;
    document.getElementById("pill-host").textContent = `🖥 ${d.system.hostname}`;
    document.getElementById("pill-uptime").textContent = `⏱ Up: ${d.system.uptime}`;
    document.getElementById("pill-rtc").textContent = `🔄 RTC: ${d.storage.rtc_mode}`;

    const vpnPill = document.getElementById("pill-vpn");
    if (d.network.vpn_active) {
      vpnPill.className = "pill vpn-ok";
      vpnPill.textContent = `🛡 VPN (${d.network.vpn_iface}): ${d.network.vpn_ip}`;
    } else {
      vpnPill.className = "pill vpn-warn";
      vpnPill.textContent = `⚠ VPN: Disconnected`;
    }
    document.getElementById("btn-mask").textContent = `👁 Pub IP: ${d.network.public_ip}`;

    // Weather
    const wx = d.weather;
    document.getElementById("wx-loc").textContent = `${wx.location} (${wx.source})`;
    document.getElementById("wx-temp").textContent = `${wx.temp_c}°C`;
    document.getElementById("wx-cond").textContent = wx.condition;
    document.getElementById("wx-icon").textContent = wx.icon || "⛅";
    document.getElementById("wx-feels").textContent = `${wx.feels_like_c}°C`;
    document.getElementById("wx-wind").textContent = `${wx.wind_kmh} km/h`;
    document.getElementById("wx-hum").textContent = `${wx.humidity}%`;
    document.getElementById("wx-forecast").innerHTML = (wx.forecast || []).map(f => `
      <div class="wx-day">
        <div style="color:var(--text-muted);">${escapeHtml(f.date.slice(5))}</div>
        <div style="font-size:16px;margin:2px 0;">${escapeHtml(f.icon)}</div>
        <div><strong>${f.max_c}°</strong> / ${f.min_c}°</div>
      </div>
    `).join("");

    // Hardware
    document.getElementById("cpu-model").textContent = `${d.cpu.model} (${d.cpu.cores} Threads @ ${d.cpu.freq_mhz} MHz)`;
    document.getElementById("cpu-temp-badge").textContent = d.cpu.temp_c ? `🌡 ${d.cpu.temp_c}°C` : "🌡 Sensor Ready";
    document.getElementById("cpu-pct").textContent = `${d.cpu.usage_pct}%`;
    document.getElementById("cpu-bar").style.width = `${d.cpu.usage_pct}%`;
    document.getElementById("core-grid").innerHTML = (d.cpu.per_core || []).slice(0, 8).map((pct, i) => `
      <div class="core-chip"><span>C${i}</span><strong style="color:var(--cyan);">${pct}%</strong></div>
    `).join("");

    document.getElementById("ram-txt").textContent = `${d.memory.used_gb} / ${d.memory.total_gb} GB (${d.memory.pct}%)`;
    document.getElementById("ram-bar").style.width = `${d.memory.pct}%`;
    document.getElementById("swap-txt").textContent = `${d.memory.swap_used_gb} / ${d.memory.swap_total_gb} GB (${d.memory.swap_pct}%)`;
    document.getElementById("swap-bar").style.width = `${d.memory.swap_pct}%`;
    document.getElementById("gpu-txt").textContent = `GPU: ${d.gpu}`;
    document.getElementById("pwr-txt").textContent = `Power: ${d.power.status} (${d.power.percent}%)`;

    // Storage & Dual-Boot
    document.getElementById("win-badge").textContent = d.storage.windows_detected ? "🪟 Windows NTFS Detected" : "Linux Partition Layout";
    document.getElementById("mounts-list").innerHTML = (d.storage.mounts || []).map(m => `
      <div class="metric-row">
        <div class="metric-top"><span>Mount <strong>${escapeHtml(m.mount)}</strong></span><span>${m.used_gb} / ${m.total_gb} GB (${m.pct}%)</span></div>
        <div class="bar-track"><div class="bar-fill green" style="width:${m.pct}%"></div></div>
      </div>
    `).join("");

    document.querySelector("#parts-table tbody").innerHTML = (d.storage.partitions || []).map(p => `
      <tr>
        <td>${escapeHtml(p.name)}</td>
        <td><span class="badge ok">${escapeHtml(p.fstype)}</span></td>
        <td>${escapeHtml(p.size)}</td>
        <td>${escapeHtml(p.mountpoint)}</td>
      </tr>
    `).join("");

    // Network & Processes
    document.getElementById("net-rate").textContent = `↓ ${d.network.rx_kbps} KB/s  ↑ ${d.network.tx_kbps} KB/s`;
    document.getElementById("ifaces-list").innerHTML = (d.network.interfaces || []).map(n =>
      `<div>🔌 <strong>${escapeHtml(n.iface)}</strong>: <span style="color:var(--cyan);">${escapeHtml(n.ip)}</span> (${escapeHtml(n.state)})</div>`
    ).join("");
    document.getElementById("listen-ports").textContent = (d.network.listening_ports || []).join(", ") || "None";

    document.querySelector("#procs-table tbody").innerHTML = (d.processes || []).map(p => `
      <tr>
        <td>${escapeHtml(p.name)}</td>
        <td>${escapeHtml(p.pid)}</td>
        <td style="color:var(--crimson);">${escapeHtml(p.cpu)}%</td>
        <td>${escapeHtml(p.mem)}%</td>
      </tr>
    `).join("");
  } catch (e) {
    console.error("Telemetry error:", e);
  }
}

async function saveContextVars() {
  const payload = {
    target: document.getElementById("ctx-target").value,
    lhost: document.getElementById("ctx-lhost").value,
    lport: document.getElementById("ctx-lport").value,
    interface: document.getElementById("ctx-iface").value,
    wordlist: document.getElementById("ctx-wordlist").value
  };
  await fetch("/api/config", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify(payload)
  });
}

async function promptWeatherCity() {
  const city = prompt("Enter your City / Location for Live Weather:", currentConfig.location || "Wheathampstead, England, GB");
  if (!city) return;
  currentConfig.location = city;
  await fetch("/api/config", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({location: city, refresh_weather: true})
  });
  refreshTelemetry();
}

async function togglePrivacyMask() {
  currentConfig.privacy_mask_ip = !currentConfig.privacy_mask_ip;
  await fetch("/api/config", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({privacy_mask_ip: currentConfig.privacy_mask_ip})
  });
  refreshTelemetry();
}

function findCmd(id) {
  return allCommands.find(c => c.id === id);
}

function copyCmd(id) {
  const c = findCmd(id);
  if (!c) return;
  const rendered = interpolateCmd(c.cmd);
  navigator.clipboard.writeText(rendered);
  const out = document.getElementById("console-output");
  out.textContent += `\n[COPIED TO CLIPBOARD] $ ${rendered}\n`;
  out.scrollTop = out.scrollHeight;
}

async function executeCardCmd(id) {
  const c = findCmd(id);
  if (!c) return;
  const rendered = interpolateCmd(c.cmd);
  document.getElementById("console-cmd-input").value = rendered;
  await executeShellCommand(rendered);
}

async function runConsoleInput() {
  const cmd = document.getElementById("console-cmd-input").value.trim();
  if (!cmd) return;
  await executeShellCommand(cmd);
}

async function executeShellCommand(cmd) {
  const out = document.getElementById("console-output");
  out.textContent += `\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n$ ${cmd}\n[Running...]\n`;
  out.scrollTop = out.scrollHeight;
  const res = await fetch("/api/execute", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({cmd})
  });
  const data = await res.json();
  out.textContent += `${data.output || "(no output)"}\n[Exit Code: ${data.exit_code}]\n`;
  out.scrollTop = out.scrollHeight;
}

function clearConsole() {
  document.getElementById("console-output").textContent = "[CONSOLE CLEARED]\n";
}

async function toggleFavorite(id) {
  const c = findCmd(id);
  if (!c) return;
  c.favorite = !c.favorite;
  await fetch("/api/commands", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({action: "save_all", commands: allCommands})
  });
  renderCommands();
}

function openAddModal() {
  document.getElementById("modal-title").textContent = "+ Add Custom Command";
  document.getElementById("m-id").value = "";
  document.getElementById("m-name").value = "";
  document.getElementById("m-cat").value = "Custom";
  document.getElementById("m-cmd").value = "";
  document.getElementById("m-pkg").value = "";
  document.getElementById("m-desc").value = "";
  document.getElementById("cmd-modal").classList.add("open");
}

function editCmd(id) {
  const c = findCmd(id);
  if (!c) return;
  document.getElementById("modal-title").textContent = "✎ Edit Command";
  document.getElementById("m-id").value = c.id;
  document.getElementById("m-name").value = c.name;
  document.getElementById("m-cat").value = c.category;
  document.getElementById("m-cmd").value = c.cmd;
  document.getElementById("m-pkg").value = c.package || c.binary || "";
  document.getElementById("m-desc").value = c.description || "";
  document.getElementById("cmd-modal").classList.add("open");
}

function closeModal() {
  document.getElementById("cmd-modal").classList.remove("open");
}

async function submitCustomCommand() {
  const id = document.getElementById("m-id").value || `custom-${Date.now()}`;
  const name = document.getElementById("m-name").value.trim();
  const category = document.getElementById("m-cat").value;
  const cmd = document.getElementById("m-cmd").value.trim();
  const pkg = document.getElementById("m-pkg").value.trim() || cmd.split(" ")[0];
  const description = document.getElementById("m-desc").value.trim() || "Custom command";
  if (!name || !cmd) {
    alert("Please provide both a Command Title and Command Template.");
    return;
  }
  const existingIdx = allCommands.findIndex(x => x.id === id);
  const item = {
    id, name, category, cmd,
    binary: pkg, package: pkg,
    tags: ["custom"],
    favorite: existingIdx >= 0 ? allCommands[existingIdx].favorite : true,
    interactive: false,
    description
  };
  if (existingIdx >= 0) {
    allCommands[existingIdx] = item;
  } else {
    allCommands.unshift(item);
  }
  const res = await fetch("/api/commands", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({action: "save_all", commands: allCommands})
  });
  allCommands = await res.json();
  closeModal();
  renderCommands();
}

async function deleteCmd(id) {
  if (!confirm("Delete this custom command?")) return;
  allCommands = allCommands.filter(c => c.id !== id);
  const res = await fetch("/api/commands", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({action: "save_all", commands: allCommands})
  });
  allCommands = await res.json();
  renderCommands();
}

fetchInitialData();
setInterval(refreshTelemetry, 2000);
</script>
</body>
