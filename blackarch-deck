def main() -> None:
    parser = argparse.ArgumentParser(
        description="BlackArch Cyberdeck UI & Menu-Driven Command Center"
    )
    parser.add_argument("--tui", action="store_true", help="Launch Terminal Curses Cyberdeck UI (default)")
    parser.add_argument("--web", action="store_true", help="Launch Graphical/Web Cyberdeck UI server")
    parser.add_argument("--gui", action="store_true", help="Launch Web UI server and open desktop app window")
    parser.add_argument("--status", action="store_true", help="Print CLI telemetry & command summary")
    parser.add_argument("--host", default="0.0.0.0", help="Bind host for --web/--gui mode (default: 0.0.0.0)")
    parser.add_argument("--port", type=int, default=8080, help="Port for --web/--gui mode (default: 8080)")
    parser.add_argument("--location", help="Set default weather location (e.g. 'Wheathampstead, England, GB')")
    parser.add_argument("--target", help="Set default engagement target IP/domain")
    args = parser.parse_args()

    ensure_config_files()
    if args.location or args.target:
        cfg = load_config()
        if args.location:
            cfg["location"] = args.location
        if args.target:
            cfg["target"] = args.target
        save_config(cfg)

    if args.status:
        print_cli_status()
    elif args.web or args.gui:
        run_web_server(args.host, args.port, open_gui=args.gui)
    else:
        engine = TelemetryEngine()
        tui = CyberdeckTUI(engine)
        curses.wrapper(tui.run)


if __name__ == "__main__":
    main()
