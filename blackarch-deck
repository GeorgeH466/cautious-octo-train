def detect_default_interface() -> str:
    try:
        out = subprocess.check_output(
            ["ip", "route", "show", "default"], text=True, stderr=subprocess.DEVNULL, timeout=2
        )
        parts = out.strip().split()
        if "dev" in parts:
            idx = parts.index("dev")
            if idx + 1 < len(parts):
                return parts[idx + 1]
    except Exception:
        pass
    try:
        net_dir = Path("/sys/class/net")
        if net_dir.exists():
            for iface in sorted(os.listdir(net_dir)):
                if iface != "lo":
                    return iface
    except Exception:
        pass
    return "eth0"


def detect_default_lhost() -> str:
    # Prefer VPN tunnel if active (tun0 / wg0)
    for vpn_iface in ("tun0", "wg0", "tap0"):
        try:
            out = subprocess.check_output(
                ["ip", "-4", "-br", "addr", "show", vpn_iface],
                text=True,
                stderr=subprocess.DEVNULL,
                timeout=1,
            ).strip()
            if out:
                parts = out.split()
                if len(parts) >= 3:
                    return parts[2].split("/")[0]
        except Exception:
            pass
    try:
        out = subprocess.check_output(
            ["ip", "-4", "-br", "addr", "show", "scope", "global"],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=1,
        ).strip()
        for line in out.splitlines():
            parts = line.split()
            if len(parts) >= 3:
                return parts[2].split("/")[0]
    except Exception:
        pass
    return "127.0.0.1"


