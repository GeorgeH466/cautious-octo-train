    <!-- Dual-Boot & Disk Partitions -->
    <div class="panel">
      <div class="panel-header">
        <div class="panel-title">💾 Dual-Boot & Storage Partitions</div>
        <span style="font-size:10.5px;color:var(--text-muted);" id="win-badge"></span>
      </div>
      <div id="mounts-list"></div>
      <div style="margin-top:8px;">
        <table class="mini-table" id="parts-table">
          <thead><tr><th>Device</th><th>FS</th><th>Size</th><th>Mount</th></tr></thead>
          <tbody></tbody>
        </table>
      </div>
    </div>

    <!-- Network, Listening Ports & Top Processes -->
    <div class="panel">
      <div class="panel-header">
        <div class="panel-title">🌐 Network, Ports & Top Processes</div>
