def ensure_config_files() -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    if not CONFIG_PATH.exists():
        CONFIG_PATH.write_text(json.dumps(DEFAULT_CONFIG, indent=2), encoding="utf-8")
    if not COMMANDS_PATH.exists():
        if DEFAULT_COMMANDS_REPO_PATH.exists():
            shutil.copyfile(DEFAULT_COMMANDS_REPO_PATH, COMMANDS_PATH)
        else:
            COMMANDS_PATH.write_text("[]", encoding="utf-8")


def load_config() -> Dict[str, Any]:
    ensure_config_files()
    try:
        data = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
        merged = dict(DEFAULT_CONFIG)
        merged.update(data)
        return merged
    except Exception:
        return dict(DEFAULT_CONFIG)


def save_config(cfg: Dict[str, Any]) -> None:
    ensure_config_files()
    CONFIG_PATH.write_text(json.dumps(cfg, indent=2), encoding="utf-8")


def load_commands() -> List[Dict[str, Any]]:
    ensure_config_files()
    try:
        cmds = json.loads(COMMANDS_PATH.read_text(encoding="utf-8"))
        if isinstance(cmds, list):
            for c in cmds:
                c["installed"] = bool(shutil.which(c.get("binary", "")))
            return cmds
    except Exception:
        pass
    if DEFAULT_COMMANDS_REPO_PATH.exists():
        try:
            cmds = json.loads(DEFAULT_COMMANDS_REPO_PATH.read_text(encoding="utf-8"))
            for c in cmds:
                c["installed"] = bool(shutil.which(c.get("binary", "")))
            return cmds
        except Exception:
            pass
    return []


def save_commands(cmds: List[Dict[str, Any]]) -> None:
    ensure_config_files()
    clean = []
    for c in cmds:
        item = dict(c)
        item.pop("installed", None)
        clean.append(item)
    COMMANDS_PATH.write_text(json.dumps(clean, indent=2), encoding="utf-8")


def render_command_template(cmd_template: str, cfg: Dict[str, Any]) -> str:
    rendered = cmd_template
    replacements = {
        "{target}": str(cfg.get("target", "127.0.0.1")),
        "{lhost}": str(cfg.get("lhost", "127.0.0.1")),
        "{lport}": str(cfg.get("lport", "4444")),
        "{interface}": str(cfg.get("interface", "eth0")),
        "{wordlist}": str(cfg.get("wordlist", "/usr/share/wordlists/rockyou.txt")),
    }
    for k, v in replacements.items():
        rendered = rendered.replace(k, v)
    return rendered


