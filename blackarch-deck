      <div class="metric-row">
        <div class="metric-top">
          <span>CPU Total Load</span>
          <strong id="cpu-pct">0%</strong>
        </div>
        <div class="bar-track"><div class="bar-fill" id="cpu-bar" style="width:0%"></div></div>
      </div>
      <div class="core-grid" id="core-grid"></div>

      <div class="metric-row">
        <div class="metric-top">
          <span>Memory (RAM)</span>
          <strong id="ram-txt">0 / 0 GB</strong>
        </div>
        <div class="bar-track"><div class="bar-fill green" id="ram-bar" style="width:0%"></div></div>
      </div>

      <div class="metric-row">
        <div class="metric-top">
          <span>Swap Space</span>
          <strong id="swap-txt">0 / 0 GB</strong>
        </div>
        <div class="bar-track"><div class="bar-fill" id="swap-bar" style="width:0%"></div></div>
      </div>

      <div style="font-size:11px;color:var(--text-muted);margin-top:8px;" id="gpu-txt">GPU: ...</div>
      <div style="font-size:11px;color:var(--emerald);margin-top:4px;" id="pwr-txt">Power: ...</div>
