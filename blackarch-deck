class TelemetryEngine:
    def __init__(self) -> None:
        self._prev_cpu_times: Optional[Dict[str, Tuple[int, int]]] = None
        self._prev_net_bytes: Optional[Tuple[float, int, int]] = None
        self._cached_gpu: Optional[str] = None
        self._cached_pkg_counts: Optional[Tuple[int, int]] = None
        self._cached_public_ip: str = "Checking..."
        self._last_pub_ip_check: float = 0.0
        self._weather_data: Optional[Dict[str, Any]] = None
        self._last_weather_fetch: float = 0.0
        self._weather_lock = threading.Lock()
        # Prime initial CPU sample
        self._read_cpu_samples()

    def _read_cpu_samples(self) -> Dict[str, Tuple[int, int]]:
        samples: Dict[str, Tuple[int, int]] = {}
        try:
            with open("/proc/stat", "r", encoding="utf-8") as f:
                for line in f:
                    if line.startswith("cpu"):
                        parts = line.split()
                        name = parts[0]
                        nums = [int(x) for x in parts[1:]]
                        idle = nums[3] + (nums[4] if len(nums) > 4 else 0)
                        total = sum(nums)
                        samples[name] = (idle, total)
        except Exception:
            pass
        return samples

    def get_cpu_telemetry(self) -> Dict[str, Any]:
        model = platform.processor() or "x86_64 Processor"
        freq_mhz = 0.0
        try:
            with open("/proc/cpuinfo", "r", encoding="utf-8") as f:
                for line in f:
                    if "model name" in line and model in ("", "x86_64", "x86_64 Processor"):
                        model = line.split(":", 1)[1].strip()
                    elif "cpu MHz" in line and freq_mhz == 0.0:
                        freq_mhz = float(line.split(":", 1)[1].strip())
        except Exception:
            pass

        cur = self._read_cpu_samples()
        prev = self._prev_cpu_times or cur
        self._prev_cpu_times = cur

        def calc_pct(key: str) -> float:
            if key not in cur or key not in prev:
                return 0.0
            idle_d = cur[key][0] - prev[key][0]
            total_d = cur[key][1] - prev[key][1]
            if total_d <= 0:
                return 0.0
            return max(0.0, min(100.0, 100.0 * (1.0 - idle_d / total_d)))

        total_pct = round(calc_pct("cpu"), 1)
        core_keys = sorted(
            [k for k in cur.keys() if k != "cpu" and k.startswith("cpu")],
            key=lambda x: int(x[3:]) if x[3:].isdigit() else 0,
        )
        per_core = [round(calc_pct(k), 1) for k in core_keys]

        # Read temperature from thermal_zone or hwmon
        temp_c: Optional[float] = None
        try:
            for tz in sorted(Path("/sys/class/thermal").glob("thermal_zone*/temp")):
                raw = int(tz.read_text(encoding="utf-8").strip())
                if raw > 1000:
                    temp_c = round(raw / 1000.0, 1)
                    break
        except Exception:
            pass
        if temp_c is None:
            try:
                for hw in sorted(Path("/sys/class/hwmon").glob("hwmon*/temp*_input")):
                    raw = int(hw.read_text(encoding="utf-8").strip())
                    if raw > 1000:
                        temp_c = round(raw / 1000.0, 1)
                        break
            except Exception:
                pass

        return {
            "model": model,
            "cores": len(per_core) or (os.cpu_count() or 1),
            "freq_mhz": round(freq_mhz, 0),
            "usage_pct": total_pct,
            "per_core": per_core[:16],
            "temp_c": temp_c,
        }

    def get_gpu_info(self) -> str:
        if self._cached_gpu is not None:
            return self._cached_gpu
        gpu_str = "Integrated / Standard Display Adapter"
        try:
            if shutil.which("lspci"):
                out = subprocess.check_output(
                    ["lspci"], text=True, stderr=subprocess.DEVNULL, timeout=2
                )
                for line in out.splitlines():
                    if any(k in line for k in ("VGA compatible controller", "3D controller", "Display controller")):
                        gpu_str = line.split(": ", 1)[-1].strip()
                        break
        except Exception:
            pass
        self._cached_gpu = gpu_str
        return gpu_str

    def get_memory_telemetry(self) -> Dict[str, Any]:
        info: Dict[str, int] = {}
        try:
            with open("/proc/meminfo", "r", encoding="utf-8") as f:
                for line in f:
                    parts = line.split(":")
                    if len(parts) == 2:
                        key = parts[0].strip()
                        val_kb = int(parts[1].strip().split()[0])
                        info[key] = val_kb
        except Exception:
            pass
        total_kb = info.get("MemTotal", 1)
        avail_kb = info.get("MemAvailable", info.get("MemFree", 0))
        used_kb = max(0, total_kb - avail_kb)
        cached_kb = info.get("Cached", 0) + info.get("Buffers", 0)
        swap_total_kb = info.get("SwapTotal", 0)
        swap_free_kb = info.get("SwapFree", 0)
        swap_used_kb = max(0, swap_total_kb - swap_free_kb)

        return {
            "total_gb": round(total_kb / (1024 * 1024), 2),
            "used_gb": round(used_kb / (1024 * 1024), 2),
            "avail_gb": round(avail_kb / (1024 * 1024), 2),
            "cached_gb": round(cached_kb / (1024 * 1024), 2),
            "pct": round((used_kb / total_kb) * 100.0, 1) if total_kb else 0.0,
            "swap_total_gb": round(swap_total_kb / (1024 * 1024), 2),
            "swap_used_gb": round(swap_used_kb / (1024 * 1024), 2),
            "swap_pct": round((swap_used_kb / swap_total_kb) * 100.0, 1) if swap_total_kb else 0.0,
        }

    def get_storage_and_dualboot(self) -> Dict[str, Any]:
        mounts: List[Dict[str, Any]] = []
        seen_devs = set()
        candidate_paths = ["/", "/home", "/mnt/windows", "/mnt/shared", "/boot/efi"]
        try:
            with open("/proc/mounts", "r", encoding="utf-8") as f:
                for line in f:
                    parts = line.split()
                    if len(parts) >= 3:
                        dev, mnt, fstype = parts[0], parts[1], parts[2]
                        if fstype in ("ext4", "btrfs", "xfs", "zfs", "ntfs", "ntfs3", "fuseblk", "vfat", "exfat", "overlay"):
                            if mnt not in candidate_paths and not mnt.startswith("/Docker") and not mnt.startswith("/etc"):
                                candidate_paths.append(mnt)
        except Exception:
            pass

        for path in candidate_paths:
            if not os.path.exists(path):
                continue
            try:
                st = shutil.disk_usage(path)
                if st.total <= 0:
                    continue
                key = (st.total, st.free)
                if path != "/" and key in seen_devs:
                    continue
                seen_devs.add(key)
                pct = round((st.used / st.total) * 100.0, 1)
                mounts.append(
                    {
                        "mount": path,
                        "total_gb": round(st.total / (1024**3), 1),
                        "used_gb": round(st.used / (1024**3), 1),
                        "free_gb": round(st.free / (1024**3), 1),
                        "pct": pct,
                    }
                )
            except Exception:
                pass

        # Detect unmounted or mounted dual-boot partitions via lsblk if available
        partitions: List[Dict[str, str]] = []
        windows_detected = False
        try:
            out = subprocess.check_output(
                ["lsblk", "-J", "-o", "NAME,FSTYPE,SIZE,MOUNTPOINT,LABEL"],
                text=True,
                stderr=subprocess.DEVNULL,
                timeout=2,
            )
            data = json.loads(out)
            for dev in data.get("blockdevices", []):
                children = dev.get("children", [dev])
                for part in children:
                    fstype = (part.get("fstype") or "").lower()
                    label = part.get("label") or ""
                    if fstype in ("ntfs", "BitLocker", "vfat", "exfat", "ext4", "btrfs", "xfs"):
                        if fstype == "ntfs" or "windows" in label.lower():
                            windows_detected = True
                        partitions.append(
                            {
                                "name": f"/dev/{part.get('name', '')}",
                                "fstype": fstype or "raw",
                                "size": part.get("size") or "",
                                "mountpoint": part.get("mountpoint") or "unmounted",
                                "label": label,
                            }
                        )
        except Exception:
            pass

        # Check RTC mode (UTC vs Local for Windows dual-boot)
        rtc_local = False
        try:
            if Path("/etc/adjtime").exists():
                content = Path("/etc/adjtime").read_text(encoding="utf-8")
                rtc_local = "LOCAL" in content
        except Exception:
            pass

        return {
            "mounts": mounts[:5],
            "partitions": partitions[:8],
            "windows_detected": windows_detected,
            "rtc_mode": "LOCAL (Dual-Boot Safe)" if rtc_local else "UTC (Standard Linux)",
        }

    def get_power_status(self) -> Dict[str, Any]:
        try:
            ps_base = Path("/sys/class/power_supply")
            if ps_base.exists():
                for bat in sorted(ps_base.glob("BAT*")):
                    cap = (bat / "capacity").read_text(encoding="utf-8").strip()
                    status = (bat / "status").read_text(encoding="utf-8").strip()
                    return {"has_battery": True, "percent": int(cap), "status": status}
        except Exception:
            pass
        return {"has_battery": False, "percent": 100, "status": "AC WORKSTATION"}

    def get_system_identity(self) -> Dict[str, Any]:
        now = datetime.datetime.now().astimezone()
        uptime_str = "0m"
        try:
            with open("/proc/uptime", "r", encoding="utf-8") as f:
                up_sec = int(float(f.read().split()[0]))
                days, rem = divmod(up_sec, 86400)
                hours, rem = divmod(rem, 3600)
                mins, _ = divmod(rem, 60)
                if days > 0:
                    uptime_str = f"{days}d {hours}h {mins}m"
                elif hours > 0:
                    uptime_str = f"{hours}h {mins}m"
                else:
                    uptime_str = f"{mins}m"
        except Exception:
            pass

        os_name = "BlackArch Linux"
        try:
            if Path("/etc/os-release").exists():
                for line in Path("/etc/os-release").read_text(encoding="utf-8").splitlines():
                    if line.startswith("PRETTY_NAME="):
                        os_name = line.split("=", 1)[1].strip().strip('"')
                        break
        except Exception:
            pass

        if self._cached_pkg_counts is None:
            total_pkgs = 0
            ba_pkgs = 0
            try:
                if shutil.which("pacman"):
                    out = subprocess.check_output(["pacman", "-Qq"], text=True, stderr=subprocess.DEVNULL, timeout=2)
                    total_pkgs = len(out.strip().splitlines())
                    out_ba = subprocess.check_output(
                        ["pacman", "-Sl", "blackarch"], text=True, stderr=subprocess.DEVNULL, timeout=2
                    )
                    ba_pkgs = sum(1 for l in out_ba.splitlines() if "[installed]" in l)
                elif shutil.which("dpkg-query"):
                    out = subprocess.check_output(
                        ["dpkg-query", "-f", "${binary:Package}\n", "-W"],
                        text=True,
                        stderr=subprocess.DEVNULL,
                        timeout=2,
                    )
                    total_pkgs = len(out.strip().splitlines())
            except Exception:
                pass
            self._cached_pkg_counts = (total_pkgs, ba_pkgs)

        load1, load5, load15 = (0.0, 0.0, 0.0)
        try:
            load1, load5, load15 = os.getloadavg()
        except Exception:
            pass

        return {
            "hostname": socket.gethostname(),
            "os": os_name,
            "kernel": platform.release(),
            "arch": platform.machine(),
            "uptime": uptime_str,
            "time": now.strftime("%H:%M:%S"),
            "date": now.strftime("%a, %d %b %Y"),
            "timezone": str(now.tzinfo or "Europe/London"),
            "load_avg": f"{load1:.2f} / {load5:.2f} / {load15:.2f}",
            "packages_total": self._cached_pkg_counts[0],
            "packages_blackarch": self._cached_pkg_counts[1],
        }

    def get_network_and_opsec(self, mask_ip: bool = False) -> Dict[str, Any]:
        interfaces: List[Dict[str, str]] = []
        vpn_active = False
        vpn_ip = ""
        vpn_iface = ""

        try:
            out = subprocess.check_output(
                ["ip", "-4", "-br", "addr"], text=True, stderr=subprocess.DEVNULL, timeout=2
            )
            for line in out.strip().splitlines():
                parts = line.split()
                if len(parts) >= 3:
                    iface, state, addr = parts[0], parts[1], parts[2].split("/")[0]
                    if iface == "lo":
                        continue
                    interfaces.append({"iface": iface, "state": state, "ip": addr})
                    if iface.startswith(("tun", "wg", "tap", "proton")):
                        vpn_active = True
                        vpn_ip = addr
                        vpn_iface = iface
        except Exception:
            pass

        # Network throughput (RX / TX KB/s)
        rx_kbps = 0.0
        tx_kbps = 0.0
        total_rx = 0
        total_tx = 0
        now_t = time.time()
        try:
            with open("/proc/net/dev", "r", encoding="utf-8") as f:
                for line in f.readlines()[2:]:
                    if ":" not in line:
                        continue
                    iface, rest = line.split(":", 1)
                    iface = iface.strip()
                    if iface == "lo":
                        continue
                    cols = rest.split()
                    if len(cols) >= 9:
                        total_rx += int(cols[0])
                        total_tx += int(cols[8])
            if self._prev_net_bytes is not None:
                dt = max(0.2, now_t - self._prev_net_bytes[0])
                rx_kbps = round((total_rx - self._prev_net_bytes[1]) / 1024.0 / dt, 1)
                tx_kbps = round((total_tx - self._prev_net_bytes[2]) / 1024.0 / dt, 1)
            self._prev_net_bytes = (now_t, total_rx, total_tx)
        except Exception:
            pass

        # Listening ports
        listening_ports: List[str] = []
        tor_active = False
        try:
            out = subprocess.check_output(
                ["ss", "-tln"], text=True, stderr=subprocess.DEVNULL, timeout=2
            )
            for line in out.splitlines()[1:]:
                cols = line.split()
                if len(cols) >= 4:
                    local_addr = cols[3]
                    port = local_addr.rsplit(":", 1)[-1]
                    if port == "9050":
                        tor_active = True
                    if port not in listening_ports:
                        listening_ports.append(port)
        except Exception:
            pass

        # Public IP check (cached asynchronously so UI never blocks)
        if now_t - self._last_pub_ip_check > 300:
            self._last_pub_ip_check = now_t
            threading.Thread(target=self._refresh_public_ip, daemon=True).start()

        pub_ip_display = self._cached_public_ip
        if mask_ip and pub_ip_display not in ("Offline / Restricted", "Checking..."):
            pub_ip_display = "***.***.***.*** (MASKED)"

        return {
            "interfaces": interfaces,
            "vpn_active": vpn_active,
            "vpn_iface": vpn_iface,
            "vpn_ip": vpn_ip,
            "tor_active": tor_active,
            "public_ip": pub_ip_display,
            "rx_kbps": max(0.0, rx_kbps),
            "tx_kbps": max(0.0, tx_kbps),
            "total_rx_mb": round(total_rx / (1024 * 1024), 1),
            "total_tx_mb": round(total_tx / (1024 * 1024), 1),
            "listening_ports": listening_ports[:10],
        }

    def _refresh_public_ip(self) -> None:
        for url in ("https://api.ipify.org", "https://ifconfig.me/ip"):
            try:
                req = urllib.request.Request(url, headers={"User-Agent": "curl/8.0"})
                with urllib.request.urlopen(req, timeout=2.5) as resp:
                    ip = resp.read().decode("utf-8").strip()
                    if ip and len(ip) <= 45:
                        self._cached_public_ip = ip
                        return
            except Exception:
                pass
        self._cached_public_ip = "Offline / Lab VLAN"

    def get_top_processes(self) -> List[Dict[str, str]]:
        procs: List[Dict[str, str]] = []
        try:
            out = subprocess.check_output(
                ["ps", "-eo", "pid,comm,%cpu,%mem", "--sort=-%cpu"],
                text=True,
                stderr=subprocess.DEVNULL,
                timeout=2,
            )
            for line in out.strip().splitlines()[1:7]:
                parts = line.split(None, 3)
                if len(parts) == 4:
                    procs.append(
                        {"pid": parts[0], "name": parts[1][:18], "cpu": parts[2], "mem": parts[3]}
                    )
        except Exception:
            pass
        return procs

    def get_weather(self, cfg: Dict[str, Any], force: bool = False) -> Dict[str, Any]:
        now_t = time.time()
        location = cfg.get("location", "Wheathampstead, England, GB")
        if not force and self._weather_data and (now_t - self._last_weather_fetch < 600):
            if self._weather_data.get("queried_location") == location:
                return self._weather_data

        # Trigger async refresh if we already have data, or synchronous first time with short timeout
        if self._weather_data is None or force:
            self._fetch_weather_sync(cfg)
        else:
            threading.Thread(target=self._fetch_weather_sync, args=(cfg,), daemon=True).start()
        return self._weather_data or self._fallback_weather(location)

    def _fetch_weather_sync(self, cfg: Dict[str, Any]) -> None:
        with self._weather_lock:
            location = cfg.get("location", "Wheathampstead, England, GB")
            lat = float(cfg.get("latitude", 51.8127))
            lon = float(cfg.get("longitude", -0.2948))

            # 1. Try Open-Meteo Geocoding + Forecast API (fast, no API key required on BlackArch PC)
            try:
                city_query = urllib.parse.quote(location.split(",")[0].strip())
                geo_url = f"https://geocoding-api.open-meteo.com/v1/search?name={city_query}&count=1&language=en&format=json"
                req = urllib.request.Request(geo_url, headers={"User-Agent": "BlackArch-Cyberdeck/1.0"})
                with urllib.request.urlopen(req, timeout=2.0) as resp:
                    geo_data = json.loads(resp.read().decode("utf-8"))
                    if geo_data.get("results"):
                        r0 = geo_data["results"][0]
                        lat = float(r0["latitude"])
                        lon = float(r0["longitude"])
                        location = f"{r0.get('name')}, {r0.get('admin1', '')}, {r0.get('country_code', '')}".replace(", ,", ",")

                wx_url = (
                    f"https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}"
                    "&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m,surface_pressure"
                    "&daily=weather_code,temperature_2m_max,temperature_2m_min&timezone=auto&forecast_days=3"
                )
                req2 = urllib.request.Request(wx_url, headers={"User-Agent": "BlackArch-Cyberdeck/1.0"})
                with urllib.request.urlopen(req2, timeout=2.5) as resp2:
                    wx = json.loads(resp2.read().decode("utf-8"))
                    cur = wx.get("current", {})
                    daily = wx.get("daily", {})
                    code = int(cur.get("weather_code", 2))
                    cond_text, cond_icon = self._wmo_code_to_text(code)
                    forecast = []
                    dates = daily.get("time", [])
                    maxs = daily.get("temperature_2m_max", [])
                    mins = daily.get("temperature_2m_min", [])
                    codes = daily.get("weather_code", [])
                    for i in range(min(3, len(dates))):
                        ft, fi = self._wmo_code_to_text(int(codes[i]))
                        forecast.append(
                            {
                                "date": dates[i],
                                "condition": ft,
                                "icon": fi,
                                "max_c": round(maxs[i], 1),
                                "min_c": round(mins[i], 1),
                            }
                        )
                    result = {
                        "location": location,
                        "queried_location": cfg.get("location", location),
                        "temp_c": round(float(cur.get("temperature_2m", 13.0)), 1),
                        "feels_like_c": round(float(cur.get("apparent_temperature", 11.5)), 1),
                        "humidity": int(cur.get("relative_humidity_2m", 76)),
                        "wind_kmh": round(float(cur.get("wind_speed_10m", 14.0)), 1),
                        "pressure_hpa": int(float(cur.get("surface_pressure", 1014))),
                        "condition": cond_text,
                        "icon": cond_icon,
                        "forecast": forecast,
                        "source": "Live Open-Meteo",
                        "updated_at": datetime.datetime.now().strftime("%H:%M"),
                    }
                    self._weather_data = result
                    self._last_weather_fetch = time.time()
                    try:
                        WEATHER_CACHE_PATH.write_text(json.dumps(result, indent=2), encoding="utf-8")
                    except Exception:
                        pass
                    return
            except Exception:
                pass

            # 2. Try wttr.in JSON API fallback
            try:
                q = urllib.parse.quote(location.split(",")[0].strip())
                wttr_url = f"https://wttr.in/{q}?format=j1"
                req = urllib.request.Request(wttr_url, headers={"User-Agent": "curl/8.0"})
                with urllib.request.urlopen(req, timeout=2.5) as resp:
                    wdata = json.loads(resp.read().decode("utf-8"))
                    cur = wdata["current_condition"][0]
                    desc = cur["weatherDesc"][0]["value"]
                    forecast = []
                    for day in wdata.get("weather", [])[:3]:
                        forecast.append(
                            {
                                "date": day.get("date", ""),
                                "condition": day["hourly"][4]["weatherDesc"][0]["value"],
                                "icon": "⛅",
                                "max_c": float(day.get("maxtempC", 14)),
                                "min_c": float(day.get("mintempC", 7)),
                            }
                        )
                    result = {
                        "location": location,
                        "queried_location": cfg.get("location", location),
                        "temp_c": float(cur.get("temp_C", 13)),
                        "feels_like_c": float(cur.get("FeelsLikeC", 12)),
                        "humidity": int(cur.get("humidity", 75)),
                        "wind_kmh": float(cur.get("windspeedKmph", 15)),
                        "pressure_hpa": int(cur.get("pressure", 1015)),
                        "condition": desc,
                        "icon": "⛅",
                        "forecast": forecast,
                        "source": "Live wttr.in",
                        "updated_at": datetime.datetime.now().strftime("%H:%M"),
                    }
                    self._weather_data = result
                    self._last_weather_fetch = time.time()
                    try:
                        WEATHER_CACHE_PATH.write_text(json.dumps(result, indent=2), encoding="utf-8")
                    except Exception:
                        pass
                    return
            except Exception:
                pass

            # 3. Check local cache or seasonal estimation when offline / in airgapped lab
            if WEATHER_CACHE_PATH.exists():
                try:
                    cached = json.loads(WEATHER_CACHE_PATH.read_text(encoding="utf-8"))
                    cached["queried_location"] = location
                    cached["location"] = location
                    cached["source"] = "Cached Telemetry"
                    self._weather_data = cached
                    self._last_weather_fetch = time.time()
                    return
                except Exception:
                    pass

            self._weather_data = self._fallback_weather(location)
            self._last_weather_fetch = time.time()

    @staticmethod
    def _wmo_code_to_text(code: int) -> Tuple[str, str]:
        mapping = {
            0: ("Clear Sky", "☀"),
            1: ("Mainly Clear", "🌤"),
            2: ("Partly Cloudy", "⛅"),
            3: ("Overcast", "☁"),
            45: ("Mist / Fog", "🌫"),
            48: ("Rime Fog", "🌫"),
            51: ("Light Drizzle", "🌦"),
            53: ("Moderate Drizzle", "🌦"),
            55: ("Dense Drizzle", "🌧"),
            61: ("Light Rain", "🌧"),
            63: ("Moderate Rain", "🌧"),
            65: ("Heavy Rain", "🌧"),
            71: ("Light Snow", "🌨"),
            80: ("Rain Showers", "🌦"),
            95: ("Thunderstorm", "⛈"),
        }
        return mapping.get(code, ("Partly Cloudy", "⛅"))

    @staticmethod
    def _fallback_weather(location: str) -> Dict[str, Any]:
        now = datetime.datetime.now()
        hour = now.hour
        is_night = hour < 7 or hour >= 19
        base_temp = 11.4 if is_night else 14.2
        today = now.date()
        return {
            "location": location,
            "queried_location": location,
            "temp_c": base_temp,
            "feels_like_c": round(base_temp - 1.3, 1),
            "humidity": 78,
            "wind_kmh": 14.5,
            "pressure_hpa": 1016,
            "condition": "Clear Night" if is_night else "Partly Cloudy",
            "icon": "🌙" if is_night else "⛅",
            "forecast": [
                {
                    "date": str(today),
                    "condition": "Partly Cloudy",
                    "icon": "⛅",
                    "max_c": 15.0,
                    "min_c": 8.2,
                },
                {
                    "date": str(today + datetime.timedelta(days=1)),
                    "condition": "Light Showers",
                    "icon": "🌦",
                    "max_c": 13.8,
                    "min_c": 7.5,
                },
                {
                    "date": str(today + datetime.timedelta(days=2)),
                    "condition": "Mostly Clear",
                    "icon": "🌤",
                    "max_c": 14.6,
                    "min_c": 7.9,
                },
            ],
            "source": "Local Station Est. (Offline/Lab)",
            "updated_at": now.strftime("%H:%M"),
        }

    def collect_all(self, cfg: Dict[str, Any]) -> Dict[str, Any]:
        return {
            "system": self.get_system_identity(),
            "cpu": self.get_cpu_telemetry(),
            "gpu": self.get_gpu_info(),
            "memory": self.get_memory_telemetry(),
            "storage": self.get_storage_and_dualboot(),
            "power": self.get_power_status(),
            "network": self.get_network_and_opsec(mask_ip=bool(cfg.get("privacy_mask_ip", False))),
            "processes": self.get_top_processes(),
            "weather": self.get_weather(cfg),
        }


# ---------------------------------------------------------------------------
# Terminal Curses Cyberdeck UI (TUI Mode)
# ---------------------------------------------------------------------------
class CyberdeckTUI:
    def __init__(self, engine: TelemetryEngine) -> None:
        self.engine = engine
        self.cfg = load_config()
        self.commands = load_commands()
        self.cat_idx = 0
        self.cmd_idx = 0
        self.search_query = ""
        self.output_lines: List[str] = [
            "[BLACKARCH CYBERDECK INITIALIZED]",
            "Tip: Use [Tab / Left / Right] to switch categories, [Up / Down] to browse commands.",
            "Tip: Press [Enter] to review & execute a command, [t] to set Target/LHOST, [w] for Weather city, [a] to Add Custom Command.",
        ]
        self.status_msg = "READY // Press [?] for Help | [q] to Quit"

    def filtered_commands(self) -> List[Dict[str, Any]]:
        cat = CATEGORIES[self.cat_idx]
        result = []
        q = self.search_query.lower().strip()
        for c in self.commands:
            if cat == "★ Favorites" and not c.get("favorite"):
                continue
            elif cat not in ("★ Favorites", "All Commands") and c.get("category") != cat:
                continue
            if q:
                hay = f"{c.get('name','')} {c.get('cmd','')} {c.get('description','')} {' '.join(c.get('tags',[]))}".lower()
                if q not in hay:
                    continue
            result.append(c)
        return result

    @staticmethod
    def _bar(pct: float, width: int = 16) -> str:
        width = max(4, width)
        filled = int(round((max(0.0, min(100.0, pct)) / 100.0) * width))
        return "█" * filled + "░" * (width - filled)

    def _prompt_input(self, stdscr: Any, title: str, initial: str = "") -> Optional[str]:
        h, w = stdscr.getmaxyx()
        box_w = min(w - 6, max(50, len(title) + 20))
        box_h = 7
        y0 = max(1, (h - box_h) // 2)
        x0 = max(2, (w - box_w) // 2)

        win = curses.newwin(box_h, box_w, y0, x0)
        win.keypad(True)
        buf = list(initial)
        cursor = len(buf)
        curses.curs_set(1)

        while True:
            win.erase()
            win.attron(curses.color_pair(1) | curses.A_BOLD)
            win.border()
            win.addstr(0, 2, f" {title[:box_w-6]} ")
            win.attroff(curses.color_pair(1) | curses.A_BOLD)

            win.addstr(2, 2, "Input (Enter=Save, Esc=Cancel):", curses.color_pair(4))
            field_w = box_w - 4
            text_str = "".join(buf)
            start_off = max(0, cursor - field_w + 2)
            visible = text_str[start_off : start_off + field_w - 1]
            win.addstr(3, 2, " " * (field_w), curses.A_REVERSE)
            win.addstr(3, 2, visible, curses.A_REVERSE | curses.color_pair(2))
            win.move(3, 2 + min(field_w - 2, cursor - start_off))
            win.refresh()

            ch = win.getch()
            if ch in (10, 13, curses.KEY_ENTER):
                curses.curs_set(0)
                return "".join(buf)
            elif ch == 27:  # ESC
                curses.curs_set(0)
                return None
            elif ch in (curses.KEY_BACKSPACE, 127, 8):
                if cursor > 0:
                    buf.pop(cursor - 1)
                    cursor -= 1
            elif ch == curses.KEY_DC:
                if cursor < len(buf):
                    buf.pop(cursor)
            elif ch == curses.KEY_LEFT:
                cursor = max(0, cursor - 1)
            elif ch == curses.KEY_RIGHT:
                cursor = min(len(buf), cursor + 1)
            elif ch == curses.KEY_HOME:
                cursor = 0
            elif ch == curses.KEY_END:
                cursor = len(buf)
            elif 32 <= ch <= 126:
                buf.insert(cursor, chr(ch))
                cursor += 1

    def _run_command_capture(self, cmd_str: str) -> None:
        self.output_lines = [f"$ {cmd_str}", "-" * 60]
        try:
            proc = subprocess.Popen(
                cmd_str,
                shell=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
            )
            out, _ = proc.communicate(timeout=25)
            for line in (out or "").splitlines()[-60:]:
                self.output_lines.append(line)
            self.output_lines.append(f"[Exit Code: {proc.returncode}]")
            self.status_msg = f"Completed command (exit {proc.returncode})"
        except subprocess.TimeoutExpired:
            proc.kill()
            self.output_lines.append("[Timed out after 25s in embedded view - use 'x' for interactive terminal]")
            self.status_msg = "Command timed out in embedded capture; press 'x' for full interactive TTY"
        except Exception as exc:
            self.output_lines.append(f"[Error: {exc}]")
            self.status_msg = f"Error: {exc}"

    def _run_command_interactive(self, stdscr: Any, cmd_str: str) -> None:
        curses.def_prog_mode()
        curses.endwin()
        print("\033[1;31m╔══════════════════════════════════════════════════════════════════════════╗\033[0m")
        print(f"\033[1;31m║ BLACKARCH CYBERDECK // INTERACTIVE EXECUTION                             ║\033[0m")
        print("\033[1;31m╚══════════════════════════════════════════════════════════════════════════╝\033[0m")
        print(f"\033[1;36m$ {cmd_str}\033[0m\n")
        try:
            rc = subprocess.call(cmd_str, shell=True)
            print(f"\n\033[1;32m[Command finished with exit code {rc}. Press Enter to return to Cyberdeck UI...]\033[0m")
            input()
        except KeyboardInterrupt:
            print("\n\033[1;33m[Interrupted. Press Enter to return to Cyberdeck UI...]\033[0m")
            input()
        curses.reset_prog_mode()
        stdscr.clear()
        stdscr.refresh()
        self.status_msg = "Returned from interactive terminal session."

    def _safe_add(self, stdscr: Any, y: int, x: int, text: str, attr: int = 0) -> None:
        h, w = stdscr.getmaxyx()
        if y < 0 or y >= h or x < 0 or x >= w:
            return
        max_len = w - x - 1
        if max_len <= 0:
            return
        try:
            stdscr.addstr(y, x, text[:max_len], attr)
        except curses.error:
            pass

    def run(self, stdscr: Any) -> None:
        curses.curs_set(0)
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_RED, -1)      # Crimson accent
        curses.init_pair(2, curses.COLOR_CYAN, -1)     # Cyber cyan
        curses.init_pair(3, curses.COLOR_GREEN, -1)    # Neon green
        curses.init_pair(4, curses.COLOR_WHITE, -1)    # Neutral white
        curses.init_pair(5, curses.COLOR_YELLOW, -1)   # Warning / Star

        stdscr.nodelay(True)
        stdscr.timeout(1000)

        last_telemetry = 0.0
        snap: Dict[str, Any] = self.engine.collect_all(self.cfg)

        while True:
            now = time.time()
            if now - last_telemetry >= 1.5:
                snap = self.engine.collect_all(self.cfg)
                last_telemetry = now

            stdscr.erase()
            h, w = stdscr.getmaxyx()

            sys_info = snap["system"]
            cpu = snap["cpu"]
            mem = snap["memory"]
            storage = snap["storage"]
            power = snap["power"]
            net = snap["network"]
            wx = snap["weather"]
            procs = snap["processes"]

            # 1. Top Cyberdeck Header Bar
            header_line = (
                f" ⚔ BLACKARCH // CYBERDECK  │  {sys_info['Hostname'] if 'Hostname' in sys_info else sys_info['hostname']} ({sys_info['kernel']})"
                f"  │  UP: {sys_info['uptime']}  │  RTC: {storage['rtc_mode'].split()[0]}"
            )
            clock_str = f"🕒 {sys_info['time']}  {sys_info['date']} "
            self._safe_add(stdscr, 0, 0, " " * (w - 1), curses.A_REVERSE | curses.color_pair(1))
            self._safe_add(stdscr, 0, 0, header_line, curses.A_REVERSE | curses.color_pair(1) | curses.A_BOLD)
            if w > len(clock_str) + 10:
                self._safe_add(
                    stdscr,
                    0,
                    w - len(clock_str) - 1,
                    clock_str,
                    curses.A_REVERSE | curses.color_pair(2) | curses.A_BOLD,
                )

            left_w = max(36, min(46, w // 3))
            right_x = left_w + 1
            right_w = max(20, w - right_x - 1)

            # 2. Left Column: Hardware, Weather, Network/OPSEC, Partitions
            row = 2
            self._safe_add(stdscr, row, 1, "┌─[ HARDWARE TELEMETRY ]───────────────┐", curses.color_pair(1) | curses.A_BOLD)
            row += 1
            temp_str = f"{cpu['temp_c']}°C" if cpu.get("temp_c") else "N/A"
            self._safe_add(stdscr, row, 1, f"│ CPU: {cpu['model'][:left_w-8]}", curses.color_pair(4))
            row += 1
            self._safe_add(
                stdscr,
                row,
                1,
                f"│ Load: [{self._bar(cpu['usage_pct'], 12)}] {cpu['usage_pct']:>4.1f}% ({temp_str})",
                curses.color_pair(2),
            )
            row += 1
            self._safe_add(
                stdscr,
                row,
                1,
                f"│ RAM : [{self._bar(mem['pct'], 12)}] {mem['used_gb']}/{mem['total_gb']}G ({mem['pct']}%)",
                curses.color_pair(3),
            )
            row += 1
            self._safe_add(
                stdscr,
                row,
                1,
                f"│ GPU : {snap['gpu'][:left_w-9]}",
                curses.color_pair(4),
            )
            row += 1
            bat_str = f"{power['percent']}% ({power['status']})" if power["has_battery"] else power["status"]
            self._safe_add(stdscr, row, 1, f"│ PWR : {bat_str}", curses.color_pair(4))
            row += 1
            for mnt in storage["mounts"][:2]:
                self._safe_add(
                    stdscr,
                    row,
                    1,
                    f"│ DSK {mnt['mount'][:8]:<8}: {mnt['used_gb']}/{mnt['total_gb']}G ({mnt['pct']}%)",
                    curses.color_pair(4),
                )
                row += 1

            # Weather Panel
            row += 1
            self._safe_add(stdscr, row, 1, "├─[ WEATHER STATION (w=City) ]─────────┤", curses.color_pair(1) | curses.A_BOLD)
            row += 1
            self._safe_add(stdscr, row, 1, f"│ Loc : {wx['location'][:left_w-9]}", curses.color_pair(2) | curses.A_BOLD)
            row += 1
            self._safe_add(
                stdscr,
                row,
                1,
                f"│ Now : {wx['icon']} {wx['temp_c']}°C (Feels {wx['feels_like_c']}°C) {wx['condition'][:14]}",
                curses.color_pair(3),
            )
            row += 1
            self._safe_add(
                stdscr,
                row,
                1,
                f"│ Wind: {wx['wind_kmh']} km/h │ Hum: {wx['humidity']}% │ {wx['pressure_hpa']}hPa",
                curses.color_pair(4),
            )
            row += 1
            if wx.get("forecast"):
                fc_str = " │ ".join(f"{d['date'][5:]}:{d['max_c']}°" for d in wx["forecast"][:3])
                self._safe_add(stdscr, row, 1, f"│ 3Day: {fc_str[:left_w-9]}", curses.color_pair(4))
                row += 1

            # Network & OPSEC Panel
            row += 1
            self._safe_add(stdscr, row, 1, "├─[ NETWORK & OPSEC (p=Mask IP) ]──────┤", curses.color_pair(1) | curses.A_BOLD)
            row += 1
            if net["vpn_active"]:
                self._safe_add(
                    stdscr,
                    row,
                    1,
                    f"│ VPN : ★ {net['vpn_iface']} ACTIVE ({net['vpn_ip']})",
                    curses.color_pair(3) | curses.A_BOLD,
                )
            else:
                self._safe_add(stdscr, row, 1, "│ VPN : ⚠ NO VPN TUNNEL (tun0/wg0 off)", curses.color_pair(5))
            row += 1
            for iface in net["interfaces"][:2]:
                self._safe_add(stdscr, row, 1, f"│ NIC : {iface['iface']} -> {iface['ip']} ({iface['state']})", curses.color_pair(2))
                row += 1
            self._safe_add(stdscr, row, 1, f"│ Pub : {net['public_ip']}", curses.color_pair(4))
            row += 1
            self._safe_add(
                stdscr,
                row,
                1,
                f"│ Rate: ↓ {net['rx_kbps']} KB/s  ↑ {net['tx_kbps']} KB/s",
                curses.color_pair(3),
            )
            row += 1
            ports_str = ", ".join(net["listening_ports"][:6]) or "None"
            self._safe_add(stdscr, row, 1, f"│ Listen: {ports_str[:left_w-11]}", curses.color_pair(4))
            row += 1

            # Top Processes
            if row + 4 < h - 2:
                row += 1
                self._safe_add(stdscr, row, 1, "├─[ TOP PROCESSES ]────────────────────┤", curses.color_pair(1) | curses.A_BOLD)
                row += 1
                for p in procs[:3]:
                    if row < h - 2:
                        self._safe_add(
                            stdscr,
                            row,
                            1,
                            f"│ {p['name']:<14} PID:{p['pid']:<6} {p['cpu']:>4}% CPU",
                            curses.color_pair(4),
                        )
                        row += 1

            # 3. Right Column: Engagement Bar + Category Tabs + Command Menu + Console
            self._safe_add(
                stdscr,
                2,
                right_x,
                f"┌─[ ENGAGEMENT CONTEXT (Press 't' to Set Target / LHOST) ]{'─' * max(0, right_w - 59)}┐",
                curses.color_pair(1) | curses.A_BOLD,
            )
            ctx_line = (
                f"│ TARGET: {self.cfg['target']}  │  LHOST: {self.cfg['lhost']}:{self.cfg['lport']}"
                f"  │  IFACE: {self.cfg['interface']}  │  SEARCH(/): {self.search_query or 'All'}"
            )
            self._safe_add(stdscr, 3, right_x, ctx_line, curses.color_pair(2) | curses.A_BOLD)

            # Category Tabs
            tab_x = right_x
            for idx, cat in enumerate(CATEGORIES):
                label = f" {idx+1}:{cat.split()[0]} "
                if tab_x + len(label) >= w - 1:
                    break
                attr = (
                    curses.A_REVERSE | curses.color_pair(1) | curses.A_BOLD
                    if idx == self.cat_idx
                    else curses.color_pair(4)
                )
                self._safe_add(stdscr, 5, tab_x, label, attr)
                tab_x += len(label) + 1

            # Filtered Commands List
            cmds = self.filtered_commands()
            if self.cmd_idx >= len(cmds):
                self.cmd_idx = max(0, len(cmds) - 1)

            list_top = 7
            console_h = max(7, min(11, h // 3))
            list_h = max(4, h - list_top - console_h - 3)

            self._safe_add(
                stdscr,
                6,
                right_x,
                f"├─[ COMMAND MENU: {CATEGORIES[self.cat_idx]} ({len(cmds)} commands) ]{'─' * max(0, right_w - 38)}┤",
                curses.color_pair(1) | curses.A_BOLD,
            )

            start_idx = max(0, self.cmd_idx - list_h + 3)
            for i in range(list_h):
                c_i = start_idx + i
                y = list_top + i
                if c_i >= len(cmds):
                    break
                c = cmds[c_i]
                star = "★" if c.get("favorite") else " "
                inst = "✓" if c.get("installed") else "+"
                line_str = f" {star} [{inst}] {c['name']:<36} │ {c['category']}"
                if c_i == self.cmd_idx:
                    self._safe_add(stdscr, y, right_x, line_str.ljust(right_w), curses.A_REVERSE | curses.color_pair(2) | curses.A_BOLD)
                else:
                    color = curses.color_pair(3) if c.get("installed") else curses.color_pair(4)
                    self._safe_add(stdscr, y, right_x, line_str, color)

            # Selected Command Detail + Output Console
            detail_y = list_top + list_h
            self._safe_add(
                stdscr,
                detail_y,
                right_x,
                f"├─[ SELECTED COMMAND & OUTPUT CONSOLE ]{'─' * max(0, right_w - 40)}┤",
                curses.color_pair(1) | curses.A_BOLD,
            )
            if cmds:
                sel = cmds[self.cmd_idx]
                rendered = render_command_template(sel["cmd"], self.cfg)
                inst_txt = "INSTALLED" if sel.get("installed") else f"NOT INSTALLED (Press 'i' -> sudo pacman -S {sel.get('package','')})"
                self._safe_add(stdscr, detail_y + 1, right_x, f"Desc: {sel.get('description','')}", curses.color_pair(4))
                self._safe_add(
                    stdscr,
                    detail_y + 2,
                    right_x,
                    f"Cmd : $ {rendered}  [{inst_txt}]",
                    curses.color_pair(3) | curses.A_BOLD,
                )
            out_start_y = detail_y + 3
            max_out_lines = max(1, h - out_start_y - 2)
            for idx, oline in enumerate(self.output_lines[-max_out_lines:]):
                self._safe_add(stdscr, out_start_y + idx, right_x, f"  {oline}", curses.color_pair(2))

            # Bottom Hotkey Footer Bar
            footer = " [Enter] Run  [x] Interactive TTY  [/] Search  [t] Set Target  [w] Weather Loc  [a] Add Cmd  [f] Fav  [i] Install Pkg  [q] Quit "
            self._safe_add(stdscr, h - 1, 0, " " * (w - 1), curses.A_REVERSE | curses.color_pair(1))
            self._safe_add(stdscr, h - 1, 0, footer, curses.A_REVERSE | curses.color_pair(1) | curses.A_BOLD)

            stdscr.refresh()

            # Handle Keyboard Input
            ch = stdscr.getch()
            if ch == -1:
                continue
            elif ch in (ord("q"), ord("Q")):
                break
            elif ch in (curses.KEY_UP, ord("k")):
                self.cmd_idx = max(0, self.cmd_idx - 1)
            elif ch in (curses.KEY_DOWN, ord("j")):
                if cmds:
                    self.cmd_idx = min(len(cmds) - 1, self.cmd_idx + 1)
            elif ch in (curses.KEY_LEFT, curses.KEY_BTAB):
                self.cat_idx = (self.cat_idx - 1) % len(CATEGORIES)
                self.cmd_idx = 0
            elif ch in (curses.KEY_RIGHT, 9):  # Tab
                self.cat_idx = (self.cat_idx + 1) % len(CATEGORIES)
                self.cmd_idx = 0
            elif ord("1") <= ch <= ord("9"):
                idx = ch - ord("1")
                if idx < len(CATEGORIES):
                    self.cat_idx = idx
                    self.cmd_idx = 0
            elif ch == ord("/"):
                q = self._prompt_input(stdscr, "Search / Filter Commands (empty to clear)", self.search_query)
                if q is not None:
                    self.search_query = q
                    self.cmd_idx = 0
            elif ch in (ord("t"), ord("T")):
                new_t = self._prompt_input(stdscr, "Set Target IP / Domain ({target})", str(self.cfg["target"]))
                if new_t:
                    self.cfg["target"] = new_t.strip()
                new_lh = self._prompt_input(stdscr, "Set LHOST IP ({lhost})", str(self.cfg["lhost"]))
                if new_lh:
                    self.cfg["lhost"] = new_lh.strip()
                new_lp = self._prompt_input(stdscr, "Set LPORT ({lport})", str(self.cfg["lport"]))
                if new_lp:
                    self.cfg["lport"] = new_lp.strip()
                save_config(self.cfg)
            elif ch in (ord("w"), ord("W")):
                new_loc = self._prompt_input(stdscr, "Set Weather Location (City, Country)", str(self.cfg["location"]))
                if new_loc:
                    self.cfg["location"] = new_loc.strip()
                    save_config(self.cfg)
                    self.engine.get_weather(self.cfg, force=True)
                    last_telemetry = 0.0
            elif ch in (ord("p"), ord("P")):
                self.cfg["privacy_mask_ip"] = not bool(self.cfg.get("privacy_mask_ip", False))
                save_config(self.cfg)
                last_telemetry = 0.0
            elif ch in (ord("f"), ord("F")):
                if cmds:
                    sel = cmds[self.cmd_idx]
                    sel["favorite"] = not bool(sel.get("favorite", False))
                    save_commands(self.commands)
            elif ch in (ord("a"), ord("A")):
                name = self._prompt_input(stdscr, "New Custom Command Name", "My Custom Scan")
                if name:
                    cmd_t = self._prompt_input(
                        stdscr,
                        "Command Template (use {target}, {lhost}, {lport}, {interface})",
                        "nmap -F {target}",
                    )
                    if cmd_t:
                        desc = self._prompt_input(stdscr, "Short Description", "Custom user command") or "Custom command"
                        bin_name = cmd_t.strip().split()[0]
                        if bin_name == "sudo" and len(cmd_t.strip().split()) > 1:
                            bin_name = cmd_t.strip().split()[1]
                        new_cmd = {
                            "id": f"custom-{int(time.time())}",
                            "name": name.strip(),
                            "category": "Custom",
                            "cmd": cmd_t.strip(),
                            "binary": bin_name,
                            "package": bin_name,
                            "tags": ["custom"],
                            "favorite": True,
                            "interactive": False,
                            "description": desc.strip(),
                            "installed": bool(shutil.which(bin_name)),
                        }
                        self.commands.insert(0, new_cmd)
                        save_commands(self.commands)
            elif ch in (ord("i"), ord("I")):
                if cmds:
                    sel = cmds[self.cmd_idx]
                    pkg = sel.get("package") or sel.get("binary") or ""
                    if pkg:
                        self._run_command_interactive(stdscr, f"sudo pacman -S --needed {pkg}")
                        self.commands = load_commands()
            elif ch in (ord("x"), ord("X")):
                if cmds:
                    sel = cmds[self.cmd_idx]
                    rendered = render_command_template(sel["cmd"], self.cfg)
                    edited = self._prompt_input(stdscr, f"Run in Interactive Terminal: {sel['name']}", rendered)
                    if edited:
                        self._run_command_interactive(stdscr, edited)
            elif ch in (10, 13, curses.KEY_ENTER, ord("r")):
                if cmds:
                    sel = cmds[self.cmd_idx]
                    rendered = render_command_template(sel["cmd"], self.cfg)
                    edited = self._prompt_input(stdscr, f"Execute Command: {sel['name']}", rendered)
                    if edited:
                        if sel.get("interactive"):
                            self._run_command_interactive(stdscr, edited)
                        else:
                            self._run_command_capture(edited)


