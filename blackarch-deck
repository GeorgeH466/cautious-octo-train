      <table class="mini-table" id="procs-table">
        <thead><tr><th>Process</th><th>PID</th><th>CPU%</th><th>MEM%</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </section>

  <!-- RIGHT COLUMN: Engagement Context, Command Menu & Integrated Console -->
  <section class="col-right">
    <!-- Engagement Variables Bar -->
    <div class="panel">
      <div class="panel-header">
        <div class="panel-title">🎯 Engagement & Target Context Variables (Live Command Interpolation)</div>
        <button class="btn btn-cyan" style="padding:4px 10px;font-size:11px;" onclick="saveContextVars()">💾 Save Context</button>
      </div>
      <div class="ctx-bar">
        <div class="ctx-field">
          <label>TARGET IP / DOMAIN ({target})</label>
          <input type="text" id="ctx-target" value="10.10.11.24" oninput="renderCommands()" />
        </div>
        <div class="ctx-field">
          <label>LHOST / TUNNEL IP ({lhost})</label>
          <input type="text" id="ctx-lhost" value="127.0.0.1" oninput="renderCommands()" />
        </div>
        <div class="ctx-field">
          <label>LPORT ({lport})</label>
          <input type="text" id="ctx-lport" value="4444" oninput="renderCommands()" />
        </div>
        <div class="ctx-field">
          <label>INTERFACE ({interface})</label>
          <input type="text" id="ctx-iface" value="eth0" oninput="renderCommands()" />
        </div>
        <div class="ctx-field">
          <label>WORDLIST PATH ({wordlist})</label>
          <input type="text" id="ctx-wordlist" value="/usr/share/wordlists/rockyou.txt" oninput="renderCommands()" />
