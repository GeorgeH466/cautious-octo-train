      <div class="cmd-controls">
        <input type="text" class="search-input" id="cmd-search" placeholder="🔍 Search commands by tool, name, description, or tag (e.g. nmap, wifi, ntfs, grub, hashcat, vpn)..." oninput="renderCommands()" />
      </div>

      <div class="cat-tabs" id="cat-tabs"></div>
      <div class="cmd-grid" id="cmd-grid"></div>
    </div>

    <!-- Integrated Cyberdeck Output Console -->
    <div class="panel">
      <div class="panel-header">
        <div class="panel-title">💻 Integrated Cyberdeck Command Console</div>
        <button class="btn" style="padding:3px 8px;font-size:11px;" onclick="clearConsole()">Clear Output</button>
      </div>
      <div class="console-box" id="console-output">[BLACKARCH CYBERDECK READY]
Select any command card above and click [▶ Execute] to run it here, or [📋 Copy] to paste into another terminal.</div>
      <div class="console-input-bar">
        <input type="text" id="console-cmd-input" placeholder="Run custom shell command or edit selected command..." onkeydown="if(event.key==='Enter') runConsoleInput()" />
