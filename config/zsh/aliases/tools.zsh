# Cyberdeck aliases — direct tool shortcuts
alias msf='msfconsole -q'; alias burp='burpsuite &|'
alias wireshark='wireshark &|'
alias serve='python3 -m http.server 8000'
alias py='python3'; alias pipx-tools='pipx list'
alias jl='journalctl -f'; alias errors='journalctl -p err -b --no-pager | tail -40'
alias failed='systemctl --failed'
