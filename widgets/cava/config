# CYBERDECK // cava — HUD audio visualizer (Super+m)
[general]
framerate = 60
autosens = 1
sensitivity = 100
bars = 0
bar_width = 2
bar_spacing = 1
bar_height = 32
lower_cutoff_freq = 50
higher_cutoff_freq = 10000

[input]
method = pulse
source = auto

[output]
method = ncurses
orientation = bottom
channels = stereo
mono_option = average
reverse = 0

[color]
background = '#0a0a0a'
foreground = '#00fff5'
gradient = 1
gradient_count = 4
gradient_color_1 = '#00b8b0'
gradient_color_2 = '#00fff5'
gradient_color_3 = '#ffb000'
gradient_color_4 = '#ff0040'

[smoothing]
gravity = 100
integral = 77
ignore = 0
monstercat = 1
waves = 0
noise_reduction = 0.77
